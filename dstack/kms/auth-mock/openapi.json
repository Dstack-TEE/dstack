{
  "openapi": "3.0.0",
  "info": {
    "title": "dstack KMS Mock Backend API",
    "description": "Mock API for dstack KMS backend - all authentications will succeed (no blockchain interaction)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "Health check and system information",
        "description": "Returns mock system status and configuration information",
        "operationId": "getSystemInfo",
        "responses": {
          "200": {
            "description": "Mock system information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MockSystemInfo"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/bootAuth/app": {
      "post": {
        "summary": "Application boot authentication (mock - always succeeds)",
        "description": "Mock validation that always allows application boot",
        "operationId": "authenticateAppBoot",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootInfo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication result (always success in mock)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bootAuth/kms": {
      "post": {
        "summary": "KMS boot authentication (mock - always succeeds)",
        "description": "Mock validation that always allows KMS boot",
        "operationId": "authenticateKmsBoot",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootInfo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication result (always success in mock)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootResponse"
                }
              }
            }
          }
        }
      }
    },
    "/checkKmsAuthorization": {
      "post": {
        "summary": "Authorize a Kms identity and return the current root epoch",
        "operationId": "checkKmsAuthorization",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization decision, including the epoch on rejection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationResult"
                }
              }
            }
          },
          "503": {
            "description": "Authorization backend unavailable; no legacy fallback."
          }
        }
      }
    },
    "/checkAppAuthorization": {
      "post": {
        "summary": "Authorize a App identity and return the current root epoch",
        "operationId": "checkAppAuthorization",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization decision, including the epoch on rejection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationResult"
                }
              }
            }
          },
          "503": {
            "description": "Authorization backend unavailable; no legacy fallback."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BootInfo": {
        "type": "object",
        "required": [
          "mrAggregated",
          "osImageHash",
          "appId",
          "composeHash",
          "instanceId",
          "deviceId"
        ],
        "properties": {
          "mrAggregated": {
            "type": "string",
            "description": "Aggregated MR measurement"
          },
          "osImageHash": {
            "type": "string",
            "description": "OS Image hash"
          },
          "appId": {
            "type": "string",
            "description": "Application ID"
          },
          "composeHash": {
            "type": "string",
            "description": "Compose hash"
          },
          "instanceId": {
            "type": "string",
            "description": "Instance ID"
          },
          "deviceId": {
            "type": "string",
            "description": "Device ID"
          },
          "tcbStatus": {
            "type": "string",
            "description": "TCB status (optional for compatibility)"
          },
          "advisoryIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Advisory IDs (optional for compatibility)"
          },
          "mrSystem": {
            "type": "string",
            "description": "MR System measurement (optional for compatibility)"
          },
          "rootEpoch": {
            "type": "integer",
            "description": "KMS root epoch the asking KMS serves; must equal MOCK_ROOT_EPOCH"
          },
          "rootEpochHash": {
            "type": "string",
            "description": "Its chain hash; must equal MOCK_ROOT_EPOCH_HASH"
          }
        }
      },
      "BootResponse": {
        "type": "object",
        "required": [
          "isAllowed",
          "reason",
          "gatewayAppId"
        ],
        "properties": {
          "isAllowed": {
            "type": "boolean",
            "description": "Whether the boot is allowed (always true in mock)",
            "example": true
          },
          "reason": {
            "type": "string",
            "description": "Reason for the decision",
            "example": "mock app always allowed"
          },
          "gatewayAppId": {
            "type": "string",
            "description": "Mock gateway application ID",
            "example": "0xmockgateway1234567890123456789012345678"
          }
        }
      },
      "MockSystemInfo": {
        "type": "object",
        "required": [
          "status",
          "kmsContractAddr",
          "gatewayAppId",
          "chainId",
          "appAuthImplementation",
          "appImplementation",
          "note"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "description": "System status"
          },
          "kmsContractAddr": {
            "type": "string",
            "description": "Mock KMS contract address",
            "example": "0xmockcontract1234567890123456789012345678"
          },
          "gatewayAppId": {
            "type": "string",
            "description": "Mock gateway application ID",
            "example": "0xmockgateway1234567890123456789012345678"
          },
          "chainId": {
            "type": "number",
            "description": "Mock blockchain chain ID",
            "example": 1337
          },
          "appAuthImplementation": {
            "type": "string",
            "description": "Mock app auth implementation address (deprecated, use appImplementation)",
            "example": "0xmockapp9876543210987654321098765432109"
          },
          "appImplementation": {
            "type": "string",
            "description": "Mock app implementation address",
            "example": "0xmockapp9876543210987654321098765432109"
          },
          "rootEpoch": {
            "type": "integer",
            "description": "MOCK_ROOT_EPOCH"
          },
          "rootEpochHash": {
            "type": "string",
            "description": "MOCK_ROOT_EPOCH_HASH"
          },
          "note": {
            "type": "string",
            "description": "Note about mock backend behavior",
            "example": "this is a mock backend - all authentications will succeed"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "message": {
            "type": "string",
            "description": "Error message"
          }
        }
      },
      "AppInfo": {
        "type": "object",
        "required": [
          "mrAggregated",
          "osImageHash",
          "appId",
          "composeHash",
          "instanceId",
          "deviceId"
        ],
        "properties": {
          "mrAggregated": {
            "type": "string",
            "description": "Aggregated MR measurement"
          },
          "osImageHash": {
            "type": "string",
            "description": "OS Image hash"
          },
          "appId": {
            "type": "string",
            "description": "Application ID"
          },
          "composeHash": {
            "type": "string",
            "description": "Compose hash"
          },
          "instanceId": {
            "type": "string",
            "description": "Instance ID"
          },
          "deviceId": {
            "type": "string",
            "description": "Device ID"
          },
          "tcbStatus": {
            "type": "string",
            "description": "TCB status (optional for compatibility)"
          },
          "advisoryIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Advisory IDs (optional for compatibility)"
          },
          "mrSystem": {
            "type": "string",
            "description": "MR System measurement (optional for compatibility)"
          }
        },
        "description": "Verified attestation identity. The KMS app ID is the KMS contract address."
      },
      "AuthorizationResult": {
        "type": "object",
        "required": [
          "isAllowed",
          "rejectionReason",
          "gatewayAppId",
          "currentRootEpoch",
          "currentRootEpochHash",
          "currentAppEpoch"
        ],
        "properties": {
          "isAllowed": {
            "type": "boolean"
          },
          "rejectionReason": {
            "type": "string",
            "description": "Empty when allowed."
          },
          "gatewayAppId": {
            "type": "string"
          },
          "currentRootEpoch": {
            "type": "integer",
            "minimum": 0
          },
          "currentRootEpochHash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$",
            "description": "Zero when no epoch is registered; authorization is denied."
          },
          "currentAppEpoch": {
            "type": "integer",
            "minimum": 0,
            "description": "Current application epoch; zero until app rotation is supported."
          }
        }
      },
      "AuthorizationRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AppInfo"
          }
        ],
        "type": "object",
        "properties": {
          "requestedRootEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Omit to use the current epoch. An explicit zero selects epoch 0; future epochs are denied."
          },
          "requestedAppEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "default": 0,
            "description": "Application epoch, independent of KMS root epochs. Only zero is currently supported."
          }
        }
      }
    }
  }
}
