{
  "name": "auth-eth-bun",
  "version": "1.0.0",
  "description": "dstack KMS ethereum backend with bun + hono + zod",
  "main": "index.ts",
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "build": "bun build index.ts --outdir ./dist --target bun",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxlint --fix .",
    "check": "bun run lint && bun run test:run"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.13",
    "viem": "2.57.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "24.19.2",
    "oxlint": "1.88.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.4"
  },
  "type": "module",
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
