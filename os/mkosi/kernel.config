CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_FUSE_FS=m
CONFIG_BLK_DEV_LOOP=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
