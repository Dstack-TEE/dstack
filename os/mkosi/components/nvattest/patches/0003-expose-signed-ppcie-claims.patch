 }
 
+Error SwitchEvidence::AttestationReport::get_switch_lock_status(uint64_t& out_lock_status) const {
+    const SwitchParsedOpaqueFieldData* lock_status_field = nullptr;
+    Error error = m_switch_opaque_data_parser.get_field(SwitchOpaqueDataType::SWITCH_LOCK_STATUS, lock_status_field);
+    if (error != Error::Ok) {
+        return error;
+    }
+    const std::vector<uint8_t>* lock_status_data = nullptr;
+    error = lock_status_field->get_byte_vector(lock_status_data);
+    if (error != Error::Ok) {
+        return error;
+    }
+    if (lock_status_data->empty() || lock_status_data->size() > sizeof(out_lock_status) ||
+        !read_little_endian(*lock_status_data, 0, lock_status_data->size(), out_lock_status)) {
+        LOG_ERROR("Invalid switch lock status size: " << lock_status_data->size());
+        return Error::SpdmParseError;
+    }
+    return Error::Ok;
+}
