# dstack guest kernel: x86_64 defconfig baseline plus explicitly audited guest
# features. Every symbol here is re-checked against the generated .config by
# scripts/check-kernel-config.sh before compilation, so a defconfig change that
# silently flips one of these fails the build instead of shipping.
CONFIG_LOCALVERSION="-dstack"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_MODULES=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_ACPI=y
CONFIG_ACPI_TABLE_UPGRADE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_INTEL_TDX_GUEST=y
CONFIG_TDX_GUEST_DRIVER=y
CONFIG_TSM_REPORTS=y
CONFIG_AMD_MEM_ENCRYPT=y
CONFIG_SEV_GUEST=y
CONFIG_EFI_COCO_SECRET=y
CONFIG_EFI_SECRET=y
CONFIG_VMGENID=y
CONFIG_VIRT_DRIVERS=y
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VSOCKETS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_NET_VENDOR_GOOGLE=y
CONFIG_GVE=y
CONFIG_NET_VENDOR_AMAZON=y
CONFIG_ENA_ETHERNET=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES_NI_INTEL=y
# Kernel TLS (`tcp_ulp = "tls"`), which dstack-gateway's optional kTLS offload
# installs the negotiated session keys into. Built in rather than a module: the
# yocto image packages modules one by one, so `=m` would need a matching
# kernel-module-tls entry in the image recipe, and a missing one fails at
# runtime rather than at build time. The gateway still treats kTLS as opt-in and
# probes for this ULP at startup, so having it available does not turn it on.
#
# CONFIG_TLS_DEVICE is deliberately left off: it hands session keys to the NIC,
# which a confidential guest has no reason to trust and no CVM NIC supports.
CONFIG_TLS=y

# The record layer kTLS uses. GCM covers the AES suites the gateway negotiates;
# ChaCha20-Poly1305 is here because a client that picks it would otherwise fail
# the handover per connection rather than at configuration time. AES-NI brings
# the accelerated GCM implementations -- on 6.11+ that includes the VAES ones,
# which is the difference between kTLS costing 18% of bulk throughput and
# gaining 20% (measured on Emerald Rapids across kernels 6.1 / 6.12 / 6.17).
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CHACHA20POLY1305=y

CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_METACOPY=y
CONFIG_FUSE_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_VETH=y
CONFIG_VLAN_8021Q=y
CONFIG_TUN=m
CONFIG_WIREGUARD=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=m
CONFIG_NFT_COMPAT=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XTABLES=m
# Docker uses the iptables-nft frontend, whose compatibility path still needs
# the xtables NAT targets to program published container ports.
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_IP_SET=m
CONFIG_IP_VS=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=y
CONFIG_CONFIGFS_FS=y
CONFIG_SECURITY=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_LEGACY_TIOCSTI=n
CONFIG_MAGIC_SYSRQ=n
CONFIG_INET_ESP=n
CONFIG_INET6_ESP=n
CONFIG_XFRM_ESP=n
CONFIG_AF_RXRPC=n
CONFIG_RXKAD=n
CONFIG_BT=n
CONFIG_WLAN=n
CONFIG_MMC=n

# Production hardening baseline required by
# os/yocto/tools/aws/audit-aws-ec2-image-hardening.sh. x86_64_defconfig enables
# KEXEC, HIBERNATION and PROC_KCORE, so each must be turned off explicitly;
# linux-yocto-tiny never had them on and the Yocto fragments therefore do not
# need to say so.
#
# KEXEC would let root inside an attested CVM boot an arbitrary kernel: the
# RTMRs and the dm-verity rootfs would no longer describe what is running,
# after KMS has already released the application keys. HIBERNATION would
# serialize private guest memory to the host-visible data disk.
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_HIBERNATION=n
CONFIG_DEBUG_FS=n
# blktrace is the only symbol reachable from x86_64_defconfig that selects
# DEBUG_FS, so DEBUG_FS=n is unachievable without turning it off. It is a
# block-IO tracing facility with no role in a production guest.
CONFIG_BLK_DEV_IO_TRACE=n
CONFIG_STRICT_DEVMEM=y
CONFIG_PROC_KCORE=n

# Power management is unused in a CVM and is what pulls HIBERNATION back in
# (PM_SLEEP is def_bool y on SUSPEND || HIBERNATE_CALLBACKS and selects PM).
# Mirrors CONFIG_PM/PM_SLEEP in meta-dstack's dstack.cfg.
#
# dstack.cfg also carries CONFIG_HOTPLUG_CPU=n, which is deliberately not
# repeated: on x86 it is "def_bool y depends on SMP", so it cannot be turned
# off while SMP is on and the Yocto fragment line has no effect there either.
CONFIG_SUSPEND=n
CONFIG_PM=n
CONFIG_PM_SLEEP=n

# Yocto dstack fragments and minimal guest-only hardware policy.
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_SERIAL_8250_PCI=y
CONFIG_NR_CPUS=512
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_KPROBES=y
CONFIG_HOTPLUG_PCI=n
CONFIG_INPUT=n
CONFIG_SCSI=n
CONFIG_CUSE=y
CONFIG_TCG_VTPM_PROXY=y
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_HASH=m
# SELinux, matching dstack-docker.cfg symbol for symbol. CONFIG_SECURITY comes
# from x86_64_defconfig here, but the rest of the chain is asserted because two
# separate steps fail silently: SELINUX needs SECURITY_NETWORK && AUDIT, and an
# LSM only registers if CONFIG_LSM names it, which depends on which
# DEFAULT_SECURITY_* is chosen.
CONFIG_SECURITY_NETWORK=y
CONFIG_AUDIT=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,ipe,bpf"
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_XFRM=y
CONFIG_XFRM_USER=y
CONFIG_XFRM_ALGO=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# ebtables is "depends on BRIDGE" and BRIDGE is a module here as it is in
# dstack-docker.cfg, so a tristate cannot exceed it and =y is unreachable in
# both builds.
CONFIG_BRIDGE_NF_EBTABLES=m
CONFIG_NETFILTER_FAMILY_BRIDGE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_IPPORTIP=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_HASH_NETIFACE=m
CONFIG_IP_SET_BITMAP_IP=m
CONFIG_IP_SET_BITMAP_PORT=m
CONFIG_IP_SET_LIST_SET=m
CONFIG_NETFILTER_XT_SET=m
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=m
CONFIG_BLK_DEV_THROTTLING=y
# dstack-docker.cfg also sets CONFIG_BLK_DEV_THROTTLING_LOW=y. That symbol was
# removed upstream and does not exist in this kernel, so the Yocto line is
# dead; asserting it here would only fail the build.
CONFIG_ISO9660_FS=y
CONFIG_PCI=y
CONFIG_CRYPTO_ECC=y
CONFIG_CRYPTO_ECDSA=y
CONFIG_CRYPTO_ECDH=y
CONFIG_DRM_I915=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_NOUVEAU=n
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_WIRELESS=n
CONFIG_USB_SUPPORT=n
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_VT=n
CONFIG_ATA=n
CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_EXPERT=y

# Managed-bridge networking for nested container managers (Incus and friends).
#
# This image's iptables is Debian's nft-backed frontend, and x86_64_defconfig
# leaves NETFILTER_XTABLES_LEGACY off, so there is no legacy ruleset here at
# all: Docker's rules land in nftables and Incus therefore selects its nftables
# firewall driver. That driver renders per-instance bridge filters in the
# nftables `bridge` family, which defconfig does not provide.
#
# This is also the capability the Yocto backend already has via
# features/netfilter/netfilter.scc while this one did not -- the two guest
# images disagreed on bridge filtering with nothing asserting either way.
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NFT_BRIDGE_META=m
CONFIG_NFT_BRIDGE_REJECT=m

# ebtables matches, reached through nft_compat when ebtables-nft cannot express
# a match natively. BRIDGE_NF_EBTABLES above builds the matches, targets and
# watchers; the legacy ebt tables (BRIDGE_NF_EBTABLES_LEGACY, BRIDGE_EBT_T_*)
# are deliberately absent, and here they are also unreachable: they require
# NETFILTER_XTABLES_LEGACY, which x86_64_defconfig leaves off and which would
# reintroduce the whole legacy stack this image does not otherwise carry.
CONFIG_BRIDGE_EBT_ARP=m
CONFIG_BRIDGE_EBT_IP=m
CONFIG_BRIDGE_EBT_IP6=m
CONFIG_BRIDGE_EBT_AMONG=m
CONFIG_BRIDGE_EBT_LIMIT=m
CONFIG_BRIDGE_EBT_VLAN=m

# The DHCP path of a managed bridge appends a CHECKSUM target so dnsmasq's
# replies reach guests with checksum-offloading virtio NICs. IP_NF_MANGLE is
# unreachable without the legacy tables, so this rides the NFT_COMPAT branch of
# the symbol's dependency -- which is how iptables-nft programs it anyway.
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m

# No IP6_NF_* counterpart to dstack-docker.cfg's: this image has no legacy
# tables at all, so there is no legacy ip6tables to complete. The nftables
# frontend synthesises the IPv6 nat table Incus lists, with no module behind it.
