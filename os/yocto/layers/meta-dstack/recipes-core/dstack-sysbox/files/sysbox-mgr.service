[Unit]
Description=sysbox-mgr (part of the Sysbox container runtime)
PartOf=sysbox.service
After=dstack-prepare.service

[Service]
Type=notify
# Requires overlayfs idmapped-mount support (backported into this tree from
# Linux 7.3). Without it Sysbox probes support incorrectly and the runtime
# mount_setattr() fails with EINVAL.
ExecStart=/usr/bin/sysbox-mgr --data-root /var/lib/sysbox
TimeoutStartSec=45
TimeoutStopSec=90
StartLimitInterval=0
NotifyAccess=main
OOMScoreAdjust=-500
LimitNOFILE=infinity
LimitNPROC=infinity
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=sysbox.service
