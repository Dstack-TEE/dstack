def prompt_text(args: argparse.Namespace) -> str:
    values = list(args.prompt)
    if values and values[0] == "--":
        values = values[1:]
    text = " ".join(values)
    if args.prompt_file:
        file_text = args.prompt_file.read_text(encoding="utf-8")
        text = f"{file_text}\n\n{text}" if text else file_text
    return text


def session_log_mode(path: Path, resume: bool) -> str:
    """Preserve earlier AI sessions when a run is resumed."""
    return "ab" if resume and path.is_file() else "wb"


def case_resume_status(
    plan: render.Plan, run_id: str, case: render.CaseEntry
) -> str | None:
    """Return the status used by selective resume, or None for a fresh case."""
    result_dir = render.case_result_dir(plan, run_id, case)
    result_path = result_dir / "result.json"
    if result_path.is_file():
        try:
            return str(validate_completed_case(case, result_dir)["status"])
        except (DstackTestError, render.ReportError):
            return "INCOMPLETE"
    lifecycle_path = (
        plan.root / "results" / run_id / "case-lifecycle" / f"{case.id}.json"
    )
    if lifecycle_path.is_file():
        lifecycle = render.load_json(lifecycle_path)
        if lifecycle.get("state") == "INFRA_ERROR":
            return "INFRA_ERROR"
        return "INCOMPLETE"
    if result_dir.is_dir() and any(result_dir.iterdir()):
        return "INCOMPLETE"
    return None


def prepare_selective_resume(
    plan: render.Plan, run_id: str, skip_statuses: set[str]
) -> list[tuple[str, str]]:
    """Archive existing cases not selected for skipping and make them runnable."""
    rerun: list[tuple[str, str]] = []
    run_dir = plan.root / "results" / run_id
    for case in plan.cases:
        status = case_resume_status(plan, run_id, case)
        if status is None or status in skip_statuses:
            continue
        result_dir = render.case_result_dir(plan, run_id, case)
        if result_dir.exists() and any(result_dir.iterdir()):
            stamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%S.%fZ")
            archive = run_dir / "attempts" / case.path.relative_to(plan.root) / stamp
            archive.parent.mkdir(parents=True, exist_ok=True)
            result_dir.replace(archive)
        lifecycle_path = run_dir / "case-lifecycle" / f"{case.id}.json"
        lifecycle_path.unlink(missing_ok=True)
        rerun.append((case.id, status))
    return rerun


INVESTIGATION_PROMPT = """When a test reveals a mismatch, failure, or documentation defect, use at most one additional bounded tool call to locate the most likely root cause. Correlate the live observation with the narrowest relevant source, configuration, protocol, or version evidence and classify the cause as product, documentation, test probe, runner, or environment. Preserve one concise diagnostic artifact without changing expected results or forcing a pass. Do not restart or reconstruct a failed fixture merely to investigate it; after preserving the diagnostic, perform only the cleanup required by the case and finalize. A required positive input, matrix row, lifecycle target, fault injector, peer, or other prerequisite may be established by case.md expected results or by the execution guide even if the generic Preconditions section omits it. When the case manifest directly confirms that prerequisite is absent, preserve one bounded manifest observation, finalize BLOCKED, and do not browse implementation source or probe unrelated targets to rediscover it."""


class ServeController:
    """Run selected cases sequentially under a long-lived dashboard server."""

    def __init__(self, plan: render.Plan, args: argparse.Namespace):
        self.plan, self.args = plan, args
        self.lock = threading.Lock()
        self.process: subprocess.Popen[bytes] | None = None
        self.current_case: str | None = None
        self.queue: list[str] = []
        self.worker: threading.Thread | None = None
        self.stop_requested = False
        self.last_event: dict[str, Any] | None = None
        self.run_dir = plan.root / "results" / args.run_id
        self.run_dir.mkdir(parents=True, exist_ok=True)
        self.events_path = self.run_dir / "serve-control.jsonl"
        self.subprocess_log = self.run_dir / "serve-subprocess.log"
        self.fixture_manager = fixtures.FixtureManager(
            self.run_dir, plan.fixture_profiles, plan.root
        )
        reconciled = self.fixture_manager.reconcile()
        if reconciled:
            self._event("fixtures.reconciled", lease_ids=reconciled)

    def _event(self, kind: str, **values: Any) -> None:
        event = {"schema_version": "1.0", "at": utc_now(), "type": kind, **values}
        with self.events_path.open("a", encoding="utf-8") as output:
            output.write(json.dumps(event, ensure_ascii=False) + "\n")
        self.last_event = event

    def _external_execution(self) -> dict[str, Any] | None:
        """Find a live run-case agent started by the plan orchestrator."""
        for case in self.plan.cases:
            result_dir = render.case_result_dir(self.plan, self.args.run_id, case)
            execution_path = result_dir / "execution.json"
            if not execution_path.is_file():
                continue
            try:
                execution = render.load_json(execution_path)
                if execution.get("state") != "RUNNING":
                    continue
                pid = int(execution["agent_pid"])
                pgid = int(execution["agent_pgid"])
                start_ticks = int(execution["agent_start_ticks"])
            except (KeyError, TypeError, ValueError, render.ReportError):
                continue
            if process_start_ticks(pid) != start_ticks:
                continue
            try:
                if os.getpgid(pid) != pgid:
                    continue
            except ProcessLookupError:
                continue
            return {
                "case_id": case.id,
                "pid": pid,
                "pgid": pgid,
                "start_ticks": start_ticks,
                "result_dir": result_dir,
            }
        return None

    def _external_orchestrator(self) -> dict[str, Any] | None:
        path = self.run_dir / "orchestrator-execution.json"
        if not path.is_file():
            return None
        try:
            execution = render.load_json(path)
            if execution.get("state") != "RUNNING":
                return None
            pid = int(execution["agent_pid"])
            pgid = int(execution["agent_pgid"])
            start_ticks = int(execution["agent_start_ticks"])
        except (KeyError, TypeError, ValueError, render.ReportError):
            return None
        if process_start_ticks(pid) != start_ticks:
            return None
        try:
            if os.getpgid(pid) != pgid:
                return None
        except ProcessLookupError:
            return None
        return {"pid": pid, "pgid": pgid, "start_ticks": start_ticks, "path": path}

    @staticmethod
    def _signal_verified(execution: dict[str, Any], sig: signal.Signals) -> bool:
        pid = int(execution["pid"])
        if process_start_ticks(pid) != int(execution["start_ticks"]):
            return False
        try:
            if os.getpgid(pid) != int(execution["pgid"]):
                return False
            os.killpg(int(execution["pgid"]), sig)
            return True
        except ProcessLookupError:
            return False

    def status(self) -> dict[str, Any]:
        with self.lock:
            internal_running = self.process is not None and self.process.poll() is None
            external = None if internal_running else self._external_execution()
            external_orchestrator = self._external_orchestrator()
            running = (
                internal_running
                or external is not None
                or external_orchestrator is not None
            )
            return {
                "enabled": True,
                "running": running,
                "current_case": self.current_case
                or (external["case_id"] if external else None),
                "queue": list(self.queue),
                "stop_requested": self.stop_requested,
                "last_event": self.last_event,
                "investigation_available": True,
                "log_agent": (
                    f"case:{self.current_case or external['case_id']}"
                    if (self.current_case or external)
                    else "orchestrator"
                ),
                "execution_source": (
                    "controlled-case"
                    if (self.current_case or external)
                    else "orchestrator"
                ),
                "settings": {
                    "agent": self.args.agent,
                    "model": self.args.model or "default",
                    "workdir": str(self.args.workdir.resolve()),
                    "run_id": self.args.run_id,
                    "plan": str(self.plan.root),
                },
            }

    def start(self, request: dict[str, Any]) -> dict[str, Any]:
        requested = request.get("case_ids")
        if not isinstance(requested, list) or not requested:
            raise DstackTestError("case_ids must be a non-empty array")
        requested_ids = {str(value) for value in requested}
        unknown = requested_ids - {case.id for case in self.plan.cases}
        if unknown:
            raise DstackTestError(f"unknown case IDs: {sorted(unknown)}")
        ordered = [case.id for case in self.plan.cases if case.id in requested_ids]
        prompt = str(request.get("prompt", "")).strip()
        investigate = bool(request.get("investigate_failures", False))
        overwrite = bool(request.get("overwrite", False))
        with self.lock:
            if self.worker and self.worker.is_alive():
                raise DstackTestError("a controlled test queue is already running")
            occupied = []
            interrupted = []
            for case_id in ordered:
                case = find_case(self.plan, case_id)
                result_dir = render.case_result_dir(self.plan, self.args.run_id, case)
                if result_dir.exists() and any(result_dir.iterdir()):
                    occupied.append(case_id)
                    execution_path = result_dir / "execution.json"
                    if (
                        execution_path.is_file()
                        and str(
                            render.load_json(execution_path).get("state", "INCOMPLETE")
                        )
                        != "COMPLETED"
                    ):
                        interrupted.append(case_id)
            completed_occupied = [
                case_id for case_id in occupied if case_id not in interrupted
            ]
            if completed_occupied and not overwrite:
                raise DstackTestError(
                    "existing results require the explicit overwrite/archive option: "
                    + ", ".join(completed_occupied)
                )
            archive_ids = set(interrupted)
            if overwrite:
                archive_ids.update(occupied)
            self.queue = list(ordered)
            (self.run_dir / ".round-stop-requested").unlink(missing_ok=True)
            self.current_case = None
            self.stop_requested = False
            self.worker = threading.Thread(
                target=self._run_queue,
                args=(prompt, investigate, archive_ids),
                daemon=True,
            )
            self._event(
                "queue.started",
                case_ids=ordered,
                investigate_failures=investigate,
                overwrite=overwrite,
            )
            self.worker.start()
        return self.status()

    def _archive_existing(self, case: render.CaseEntry) -> None:
        result_dir = render.case_result_dir(self.plan, self.args.run_id, case)
        if not result_dir.exists() or not any(result_dir.iterdir()):
            return
        stamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%S.%fZ")
        archive = (
            self.run_dir / "attempts" / case.path.relative_to(self.plan.root) / stamp
        )
        archive.parent.mkdir(parents=True, exist_ok=True)
        result_dir.replace(archive)
        self._event(
            "case.archived",
            case_id=case.id,
            archive=str(archive.relative_to(self.plan.root)),
        )

    def _case_command(self, case_id: str, prompt: str, investigate: bool) -> list[str]:
        command = [
            str(Path(__file__).resolve()),
            "run-case",
            "--plan",
            str(self.plan.root),
            "--run-id",
            self.args.run_id,
            "--case",
            case_id,
            "--agent",
            self.args.agent,
            "--workdir",
            str(self.args.workdir.resolve()),
        ]
        if self.args.model:
            command += ["--model", self.args.model]
        for value in self.args.agent_arg:
            command.append(f"--agent-arg={value}")
        parts = [prompt_text(self.args), prompt]
        if investigate:
            parts.append(INVESTIGATION_PROMPT)
        combined = "\n\n".join(part for part in parts if part)
        if combined:
            command += ["--", combined]
        return command

    def _run_queue(self, prompt: str, investigate: bool, archive_ids: set[str]) -> None:
        while True:
            with self.lock:
                if self.stop_requested or not self.queue:
                    self.current_case = None
                    self.process = None
                    break
                case_id = self.queue.pop(0)
                self.current_case = case_id
            case = find_case(self.plan, case_id)
            if case_id in archive_ids:
                self._archive_existing(case)
            command = self._case_command(case_id, prompt, investigate)
            environment = os.environ.copy()
            environment.pop("DSTACK_TEST_CONTROL_DIR", None)
            self._event("case.started", case_id=case_id)
            with self.subprocess_log.open("ab") as output:
                process = subprocess.Popen(
                    command,
                    cwd=self.args.workdir,
                    env=environment,
                    stdout=output,
                    stderr=subprocess.STDOUT,
                    start_new_session=True,
                )
                with self.lock:
                    self.process = process
                exit_code = process.wait()
            with self.lock:
                stopped = self.stop_requested
                self.process = None
            result_dir = render.case_result_dir(self.plan, self.args.run_id, case)
            if stopped:
                atomic_json(
                    result_dir / "execution.json",
                    {
                        "schema_version": "1.0",
                        "state": "TERMINATED",
                        "case_id": case_id,
                        "finished_at": utc_now(),
                        "exit_code": exit_code,
                    },
                )
                self._event("case.terminated", case_id=case_id, exit_code=exit_code)
                break
            self._event("case.finished", case_id=case_id, exit_code=exit_code)
            if exit_code != 0:
                with self.lock:
                    self.queue.clear()
                self._event(
                    "queue.failed",
                    case_id=case_id,
                    exit_code=exit_code,
                    reason="case runner exited without a usable completion",
                )
                break
        with self.lock:
            self.current_case = None
            self.queue.clear()
            self.process = None
        self._event("queue.finished", stopped=self.stop_requested)

    def stop(self) -> dict[str, Any]:
        atomic_json(
            self.run_dir / ".round-stop-requested",
            {"at": utc_now(), "source": "dashboard"},
        )
        with self.lock:
            self.stop_requested = True
            self.queue.clear()
            process = self.process
            case_id = self.current_case
        execution = self._external_execution()
        orchestrator = self._external_orchestrator()
        signalled: list[dict[str, Any]] = []
        if execution is not None:
            case_id = execution["case_id"]
            atomic_json(
                execution["result_dir"] / ".stop-requested",
                {"at": utc_now(), "source": "dashboard"},
            )
            if self._signal_verified(execution, signal.SIGTERM):
                signalled.append(execution)
                atomic_json(
                    execution["result_dir"] / "execution.json",
                    {
                        "schema_version": "1.0",
                        "state": "TERMINATED",
                        "case_id": case_id,
                        "finished_at": utc_now(),
                        "reason": "stopped from dashboard",
                    },
                )
        elif process is not None and process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        if orchestrator is not None:
            if self._signal_verified(orchestrator, signal.SIGTERM):
                signalled.append(orchestrator)
                atomic_json(
                    orchestrator["path"],
                    {
                        "schema_version": "1.0",
                        "state": "TERMINATED",
                        "finished_at": utc_now(),
                        "reason": "stopped from dashboard",
                    },
                )

        if signalled:

            def escalate() -> None:
                time.sleep(10)
                for item in signalled:
                    self._signal_verified(item, signal.SIGKILL)

            threading.Thread(target=escalate, daemon=True).start()
        self._event("queue.stop-requested", case_id=case_id)
        return self.status()


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if os.environ.get("DSTACK_TEST_CONTROL_DIR") and args.subcommand in (
        "next-case",
        "run-case",
        "complete-case",
    ):
        if args.subcommand == "next-case":
            value = control_request({"action": "next-case"})
        elif args.subcommand == "run-case":
            value = control_request({"action": "run-case", "case": args.case})
        else:
            value = control_request(
                {
                    "action": "complete-case",
                    "case": args.case,
                    "result": args.result,
                    "blocked_by": args.blocked_by,
                    "reason": args.reason,
                }
            )
        print(json.dumps(value, ensure_ascii=False, indent=2))
        return 0
    if not getattr(args, "plan", None):
        raise DstackTestError(
            "--plan is required outside a controlled run-plan session"
        )
    plan = render.load_plan(args.plan)
    if args.subcommand == "run-case":
        value = run_case(
            plan,
            find_case(plan, args.case),
            args.run_id,
            args.agent,
            args.model,
            args.workdir.resolve(),
            prompt_text(args),
            args.agent_arg,
            args.overwrite,
            args.retain_on_failure,
        )
    elif args.subcommand == "run-plan":
        if args.skip and not args.resume:
            raise DstackTestError("--skip requires --resume")
        if args.skip and args.overwrite:
            raise DstackTestError("--skip cannot be combined with --overwrite")
        run_dir = plan.root / "results" / args.run_id
        existing = run_dir.exists() or any(
            (render.case_result_dir(plan, args.run_id, case)).exists()
            for case in plan.cases
        )
        if existing and not (args.overwrite or args.resume):
            raise DstackTestError(
                f"run {args.run_id!r} already exists; pass --resume or --overwrite"
            )
        if args.overwrite:
            shutil.rmtree(run_dir, ignore_errors=True)
            for case in plan.cases:
                shutil.rmtree(
                    render.case_result_dir(plan, args.run_id, case), ignore_errors=True
                )
        run_dir.mkdir(parents=True, exist_ok=True)
        (run_dir / ".round-stop-requested").unlink(missing_ok=True)
        if args.resume and args.skip:
            rerun = prepare_selective_resume(plan, args.run_id, set(args.skip))
            print(
                "selective resume: retained statuses "
                + ", ".join(args.skip)
                + f"; archived {len(rerun)} case(s) for rerun",
                file=sys.stderr,
                flush=True,
            )
        effective_model = resolve_model(args.agent, args.model)
        state = ControlState(plan, args, effective_model)
        control_dir = run_dir / "control"
        server = FileControlServer(state, control_dir)
        server.start()
        dashboard = None
        dashboard_controller = None
        if args.web:
            dashboard_controller = ServeController(plan, args)
            token = args.control_token or secrets.token_urlsafe(24)

            def run_plan_control(
                action: str, request: dict[str, Any]
            ) -> dict[str, Any]:
                if action == "start":
                    return dashboard_controller.start(request)
                if action == "stop":
                    return dashboard_controller.stop()
                raise DstackTestError(f"unsupported dashboard action: {action}")

            dashboard = web.Dashboard(
                lambda requested: dashboard_state(
                    plan,
                    selected_run_id(plan, requested, args.run_id),
                    dashboard_controller.status()
                    if selected_run_id(plan, requested, args.run_id) == args.run_id
                    else {"enabled": False, "running": False},
                ),
                lambda selected, agent, offset: dashboard_log(
                    plan, selected_run_id(plan, selected, args.run_id), agent, offset
                ),
                lambda selected, case_id: dashboard_case(
                    plan, selected_run_id(plan, selected, args.run_id), case_id
                ),
                lambda: dashboard_runs(plan, args.run_id),
                args.web_host,
                args.web_port,
                control=run_plan_control,
                control_token=token,
                attachment=lambda selected, case_id, relative: dashboard_attachment(
                    plan,
                    selected_run_id(plan, selected, args.run_id),
                    case_id,
                    relative,
                ),
            )
            dashboard.start()
            web_host, web_port = dashboard.address
            print(
                f"dashboard: http://{web_host}:{web_port}/#token={token}",
                file=sys.stderr,
                flush=True,
            )
        if args.driver == "program":
            orchestrator_execution = run_dir / "orchestrator-execution.json"
            atomic_json(
                orchestrator_execution,
                {
                    "schema_version": "1.0",
                    "state": "RUNNING",
                    "driver": "program",
                    "agent_pid": os.getpid(),
                    "agent_pgid": os.getpgid(0),
                    "agent_start_ticks": process_start_ticks(os.getpid()),
                    "started_at": utc_now(),
                },
            )
            try:
                orchestrator_exit_code = ProgrammaticOrchestrator(
                    state, run_dir, require_script=args.require_script
                ).run()
            except BaseException:
                atomic_json(
                    orchestrator_execution,
                    {
                        "schema_version": "1.0",
                        "state": "TERMINATED",
                        "driver": "program",
                        "finished_at": utc_now(),
                        "reason": "run-plan interrupted",
                    },
                )
                raise
            finally:
                server.close()
                shutil.rmtree(control_dir, ignore_errors=True)
            atomic_json(
                orchestrator_execution,
                {
                    "schema_version": "1.0",
                    "state": "COMPLETED"
                    if orchestrator_exit_code == 0
                    else "TERMINATED",
                    "driver": "program",
                    "exit_code": orchestrator_exit_code,
                    "finished_at": utc_now(),
                },
            )
            atomic_json(
                run_dir / "orchestrator-runner.json",
                {
                    "schema_version": "1.0",
                    "agent": {"type": "program", "model": "none"},
                    "events": sum(1 for _ in (run_dir / "driver.jsonl").open())
                    if (run_dir / "driver.jsonl").is_file()
                    else 0,
                    "exit_code": orchestrator_exit_code,
                },
            )
            if dashboard:
                print(
                    "automatic plan execution ended; dashboard control remains "
                    "available",
                    file=sys.stderr,
                    flush=True,
                )
                try:
                    dashboard.thread.join()
                except KeyboardInterrupt:
                    dashboard.close()
            run = finalize_run(plan, args.run_id, context_value(args.context))
            value = {"orchestrator_exit_code": orchestrator_exit_code, "run": run}
            print(json.dumps(value, ensure_ascii=False, indent=2))
            return 0 if orchestrator_exit_code == 0 else 1
        prompt = orchestration_prompt(plan, prompt_text(args))
        (run_dir / "orchestrator-prompt.md").write_text(prompt, encoding="utf-8")
        environment = os.environ.copy()
        environment["DSTACK_TEST_CONTROL_DIR"] = str(control_dir)
        command = agent_command(
            args.agent, effective_model, args.workdir.resolve(), prompt, args.agent_arg
        )
        orchestrator_session = run_dir / "orchestrator.jsonl"
        orchestrator_stderr = run_dir / "orchestrator-stderr.log"
        try:
            with (
                orchestrator_session.open(
                    session_log_mode(orchestrator_session, args.resume)
                ) as stdout,
                orchestrator_stderr.open(
                    session_log_mode(orchestrator_stderr, args.resume)
                ) as stderr,
            ):
                orchestrator = subprocess.Popen(
                    command,
                    cwd=args.workdir,
                    env=environment,
                    stdout=stdout,
                    stderr=stderr,
                    start_new_session=True,
                )
                orchestrator_execution = run_dir / "orchestrator-execution.json"
                atomic_json(
                    orchestrator_execution,
                    {
                        "schema_version": "1.0",
                        "state": "RUNNING",
                        "agent_pid": orchestrator.pid,
                        "agent_pgid": orchestrator.pid,
                        "agent_start_ticks": process_start_ticks(orchestrator.pid),
                        "started_at": utc_now(),
                    },
                )
                try:
                    orchestrator_exit_code = orchestrator.wait()
                except BaseException:
                    # The orchestrator runs in its own process group.  Waiting in
                    # the parent does not forward Ctrl-C (or another shutdown
                    # exception) to that group, so explicitly terminate it before
                    # tearing down the control server.  Otherwise an orphaned
                    # agent can attach to a later server for the same run and
                    # advance the case cursor concurrently.
                    if orchestrator.poll() is None:
                        os.killpg(orchestrator.pid, signal.SIGTERM)
                        try:
                            orchestrator.wait(timeout=10)
                        except subprocess.TimeoutExpired:
                            os.killpg(orchestrator.pid, signal.SIGKILL)
                            orchestrator.wait()
                    atomic_json(
                        orchestrator_execution,
                        {
                            "schema_version": "1.0",
                            "state": "TERMINATED",
                            "exit_code": orchestrator.returncode,
                            "finished_at": utc_now(),
                            "reason": "run-plan parent interrupted",
                        },
                    )
                    raise
                atomic_json(
                    orchestrator_execution,
                    {
                        "schema_version": "1.0",
                        "state": "COMPLETED"
                        if orchestrator_exit_code == 0
                        else "TERMINATED",
                        "exit_code": orchestrator_exit_code,
                        "finished_at": utc_now(),
                    },
                )
        finally:
            server.close()
            shutil.rmtree(control_dir, ignore_errors=True)
        if dashboard:
            print(
                "automatic plan execution ended; dashboard control remains available",
                file=sys.stderr,
                flush=True,
            )
            try:
                dashboard.thread.join()
            except KeyboardInterrupt:
                dashboard.close()
        events, detected_model = validate_session(run_dir / "orchestrator.jsonl")
        atomic_json(
            run_dir / "orchestrator-runner.json",
            {
                "schema_version": "1.0",
                "agent": {
                    "type": args.agent,
                    "model": detected_model or effective_model or "unknown",
                },
                "events": events,
                "exit_code": orchestrator_exit_code,
            },
        )
        run = finalize_run(plan, args.run_id, context_value(args.context))
        value = {"orchestrator_exit_code": orchestrator_exit_code, "run": run}
    elif args.subcommand == "verify-registry":
        value = verify_registry(plan)
        print(json.dumps(value, ensure_ascii=False, indent=2))
        return 0 if not value["findings"] else 1
    elif args.subcommand == "sweep":
        value = scripted_sweep(
            plan,
            args.run_id,
            args.case,
            args.workers,
            args.runtime_manifest,
            args.retain_on_failure,
        )
    elif args.subcommand == "finalize":
        value = finalize_run(plan, args.run_id, context_value(args.context))
    elif args.subcommand == "validate":
        value = validate_run(plan, args.run_id)
    elif args.subcommand == "package":
        package_plan(plan, args.run_id, args.output)
        value = {
            "status": "packaged",
            "output": str(args.output),
            "sha256": hashlib.sha256(args.output.read_bytes()).hexdigest(),
        }
    elif args.subcommand == "render":
        validate_run(plan, args.run_id)
        run, results = render.load_session_results(plan, args.run_id)
        rendered = render.render_report(plan, run, results)
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(rendered, encoding="utf-8")
        value = {
            "status": "rendered",
            "output": str(args.output),
            "bytes": args.output.stat().st_size,
        }
    elif args.subcommand == "serve":
        controller = ServeController(plan, args)
        token = args.control_token or secrets.token_urlsafe(24)

        def serve_control(action: str, request: dict[str, Any]) -> dict[str, Any]:
            if action == "start":
                return controller.start(request)
            if action == "stop":
                return controller.stop()
            raise DstackTestError(f"unsupported dashboard action: {action}")

        dashboard = web.Dashboard(
            lambda requested: dashboard_state(
                plan,
                selected_run_id(plan, requested, args.run_id),
                controller.status()
                if selected_run_id(plan, requested, args.run_id) == args.run_id
                else {"enabled": False, "running": False},
            ),
            lambda selected, agent, offset: dashboard_log(
                plan, selected_run_id(plan, selected, args.run_id), agent, offset
            ),
            lambda selected, case_id: dashboard_case(
                plan, selected_run_id(plan, selected, args.run_id), case_id
            ),
            lambda: dashboard_runs(plan, args.run_id),
            args.host,
            args.port,
            control=serve_control,
            control_token=token,
            attachment=lambda selected, case_id, relative: dashboard_attachment(
                plan,
                selected_run_id(plan, selected, args.run_id),
                case_id,
                relative,
            ),
        )
        dashboard.start()
        host, port = dashboard.address
        print(
            f"dashboard: http://{host}:{port}/#token={token}",
            file=sys.stderr,
            flush=True,
        )
        try:
            dashboard.thread.join()
        except KeyboardInterrupt:
            dashboard.close()
        return 0
    else:
        raise AssertionError(args.subcommand)
    print(json.dumps(value, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (DstackTestError, render.ReportError) as error:
        print(
            json.dumps({"status": "error", "message": str(error)}, ensure_ascii=False),
            file=sys.stderr,
        )
        raise SystemExit(2)
