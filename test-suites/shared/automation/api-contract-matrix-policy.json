  "rationale": {
    "skip": {
      "Admin.Exit": "a valid call stops the gateway, so the fixture could not be reused for the rest of the matrix",
      "Admin.RenewCert": "a valid call places an ACME order against the configured directory",
      "Admin.ReloadCert": "a valid call replaces the live certificate store for every listener",
      "Admin.SetCaa": "a valid call mutates CAA records in a real DNS zone",
      "Onboard.Bootstrap": "a valid call fixes the KMS root identity for the life of the deployment",
      "Onboard.Onboard": "a valid call makes the KMS fetch root private keys from a caller-supplied URL",
      "Onboard.Finish": "a valid call ends the onboarding listener and the bring-up that depends on it"
    },
    "rejection-only": "the method mutates state that outlives one case, or requires an attested identity the matrix does not hold, so only inputs that must be refused before dispatch are sent"
